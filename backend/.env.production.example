# PLAZA Backend - Production Environment Template
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database Configuration (Managed Cloud SQL / RDS with SSL)
DB_HOST=prod-primary-db.plaza.internal
DB_PORT=5432
DB_USER=plaza_prod_app
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_SECRET
DB_NAME=plaza_production
DB_SYNC=false
DB_SSL=true
DB_LOGGING=error

# Authentication & Cryptographic Security
JWT_SECRET=REPLACE_WITH_MINIMUM_256BIT_BASE64_RANDOM_SECRET
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://plaza.club,https://admin.plaza.club
THROTTLE_TTL=60
THROTTLE_LIMIT=60
BODY_SIZE_LIMIT=1mb

# External Integrations (Production Payment Gateway / SMS Gateway)
PAYMENT_GATEWAY_URL=https://api.razorpay.com/v1
PAYMENT_GATEWAY_KEY=REPLACE_WITH_PROD_PAYMENT_KEY
PAYMENT_GATEWAY_SECRET=REPLACE_WITH_PROD_PAYMENT_SECRET
MESSAGING_GATEWAY_URL=https://api.twilio.com/2010-04-01
MESSAGING_GATEWAY_SID=REPLACE_WITH_PROD_TWILIO_SID
MESSAGING_GATEWAY_TOKEN=REPLACE_WITH_PROD_TWILIO_TOKEN
