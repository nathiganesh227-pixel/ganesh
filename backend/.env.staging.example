# PLAZA Backend - Staging Environment Template
NODE_ENV=staging
PORT=3000
API_PREFIX=api/v1

# Database Configuration (Option A: Direct URL for Cloud Managed Postgres)
# DATABASE_URL=postgresql://user:password@cloud-host:5432/plaza_staging?sslmode=require
DB_SSL=true
DB_MIGRATIONS_RUN=true
DB_SYNC=false

# Database Configuration (Option B: Discrete Host/Port/Credentials)
DB_HOST=staging-db.plaza.internal
DB_PORT=5432
DB_USER=plaza_staging_app
DB_PASSWORD=REPLACE_WITH_STAGING_PASSWORD
DB_NAME=plaza_staging

# Redis (NOTE: Redis not currently required; PostgreSQL handles transactions & idempotency)
# REDIS_URL=redis://staging-redis:6379

# Authentication & Security
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_STAGING_SECRET
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
THROTTLE_TTL=60
THROTTLE_LIMIT=120
BODY_SIZE_LIMIT=2mb

# Payment Provider (Razorpay Sandbox)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Notification Provider (Twilio SMS)
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_YOUR_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_YOUR_AUTH_TOKEN
TWILIO_FROM_PHONE=+15005550006
